{
  "name": "tmx-scheduler",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TokenMinds-co/tmx-scheduler.git"
  },
  "homepage": "https://github.com/TokenMinds-co/tmx-scheduler#readme",
  "bugs": "https://github.com/TokenMinds-co/tmx-scheduler/issues",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm -r --parallel --filter ./backend --filter ./frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter @tmx-scheduler/shared build && pnpm -r --filter ./backend --filter ./frontend build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter backend test",
    "lint": "eslint .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "seed": "pnpm --filter backend seed",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.26",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.1"
  }
}
