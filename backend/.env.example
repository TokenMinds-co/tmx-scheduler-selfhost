# Copy to backend/.env and fill in. Never commit the real file.

NODE_ENV=development
# Under docker compose (backend/docker-compose*.yml) this is the HOST port; the
# app inside the container is pinned to 4000 by the compose file.
PORT=4000

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Postgres. Points at the existing local-postgres container on 5433, in its
# own mail_scheduler database alongside whatever else lives there.
#
# Neither service is part of the backend's compose stack — in production both
# are the server's own shared containers, so these name them directly, e.g.
# postgresql://user:pass@local-postgres:5432/mail_scheduler?schema=public and
# redis://redis:6379. The container reaches them by joining their networks.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mail_scheduler?schema=public
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Generate with: pnpm --filter backend keygen
# Encrypts SMTP passwords and OAuth secrets at rest (AES-256-GCM).
# Rotating it means re-encrypting every stored secret — see README.
CREDS_KEY=

# Signs admin session tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Signs one-click unsubscribe links. Separate from JWT_SECRET so an unsubscribe
# token can never be replayed as a session.
UNSUBSCRIBE_SECRET=change-me-too

# Signs open and click tracking links. Separate from the other secrets so a
# leaked tracking URL cannot be replayed as an unsubscribe or a session.
TRACKING_SECRET=change-me-as-well

# Host that tracking links point at. Defaults to PUBLIC_API_URL, which is what
# makes local testing against Mailpit work. In production give it its own
# subdomain of the sending domain — track.tmx.center — so link rewriting does
# not point recipients at an unfamiliar host.
TRACKING_BASE_URL=

# Public base URL of the API, used to build unsubscribe links in outgoing mail.
PUBLIC_API_URL=http://localhost:4000

# Poller: how often to sweep for due mail, and how many rows to claim per tick.
POLL_INTERVAL_MS=2000
CLAIM_BATCH_SIZE=50

# Worker: how many sends run at once across all mailboxes.
SEND_CONCURRENCY=5

# A row stuck in `sending` longer than this is returned to `pending` by the
# reaper — this is what makes a worker crash recoverable.
STUCK_SENDING_TIMEOUT_MS=600000

# Set true to log messages instead of handing them to SMTP. Useful for a first
# dry run against real data.
DRY_RUN_SENDING=false

# Bootstrap admin created by `pnpm seed` if the users collection is empty.
SEED_ADMIN_EMAIL=admin@tokenminds.co
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Admin
